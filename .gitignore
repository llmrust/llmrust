/target

# OpenCode session metadata (must never be committed)
.omo/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Scratch / temporary working files — keep them OUT of the repo root.
# Put transient artifacts (CI run dumps, audit scratch, logs) here and
# delete them when the task is done. Never commit anything under /.tmp/.
/.tmp/

# Agent workforce loop runtime state (machine-written, never hand-edited)
.workforce/loop-state.json


# agent-workforce-loop：运行态与日志不得进包（package_guard 禁止 *.log）
.workforce/*.log
.workforce/loop-state.json
.workforce/bootstrap-progress.md
.workforce/tmp/
.workforce/evidence/*.log
