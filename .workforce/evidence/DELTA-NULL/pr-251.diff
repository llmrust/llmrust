+  const st = s.trim();
+  if (/^[RC]/.test(st) && p.includes(' -> ')) p = p.split(' -> ').pop().trim();
+  if (p.length >= 2 && p.startsWith('"') && p.endsWith('"')) p = p.slice(1, -1);
+  return p;
+}
