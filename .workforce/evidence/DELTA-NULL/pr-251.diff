@@ -0,0 +1,107 @@
+#!/usr/bin/env node
+/**
+ * 用户本人的「同意」——只给用户在自己的终端里跑，agent 不要代跑。
+ *
+ *   node approve.mjs setup  --repo <仓库>   第一次：设审批密码，生成你的审批钥匙（私钥加密存你电脑主目录，公钥进仓库）
+ *   node approve.mjs config --repo <仓库>   看过规则表后签名同意（绑定规则表当前内容）
+ *   node approve.mjs spec   --repo <仓库>   acceptance.user_confirm=true 时，签名同意开工范围
+ *   node approve.mjs whoami --repo <仓库>   看你的指纹，和仓库里登记的是否一致
+ *
+ * 必须在真实终端运行（要输入隐藏密码）；没有密码，任何人都签不出你的同意。
+ * 改了规则表就要重新同意；开工后规则表再改，loop 一律拒绝（CONFIG_DRIFT）。
+ */
+import { readFileSync, writeFileSync, existsSync, mkdirSync } from 'node:fs';
+import { join, dirname, resolve } from 'node:path';
+import { homedir } from 'node:os';
+import * as L from './lib.mjs';
+
+const argv = process.argv.slice(2);
+const cmd = argv[0];
+const flag = (k) => { const i = argv.indexOf('--' + k); return i > -1 ? argv[i + 1] : undefined; };
+const repo = resolve(flag('repo') || process.cwd());
+const P = L.paths(repo, { dir: flag('dir') });
+const KEY_HOME = process.env.AWL_APPROVER_HOME || join(homedir(), '.agent-workforce');
+const KEY_FILE = join(KEY_HOME, 'approver-key.json');
+const say = (s) => process.stdout.write(s + '\n');
+const die = (s) => { say('\n✗ ' + s); process.exit(1); };
+
+function ask(q, hidden = false) {
+  return new Promise((res) => {
+    process.stdout.write(q);
+    const stdin = process.stdin; let buf = '';
+    stdin.setRawMode(true); stdin.resume(); stdin.setEncoding('utf8');
+    const on = (ch) => {
+      for (const c of ch) {
+        if (c === '\r' || c === '\n') { stdin.setRawMode(false); stdin.pause(); stdin.off('data', on); process.stdout.write('\n'); return res(buf); }
+        if (c === '\u0003') { process.stdout.write('\n'); process.exit(130); }
+        if (c === '\u007f' || c === '\b') { if (buf.length) { buf = buf.slice(0, -1); if (!hidden) process.stdout.write('\b \b'); } continue; }
+        buf += c; if (!hidden) process.stdout.write(c);
+      }
+    };
+    stdin.on('data', on);
+  });
+}
+
+if (!['setup', 'config', 'spec', 'whoami'].includes(cmd)) die('用法：node approve.mjs setup|config|spec|whoami --repo <仓库>');
+if (cmd !== 'whoami' && !(process.stdin.isTTY && process.stdout.isTTY)) die('APPROVE_NEEDS_TERMINAL：必须由你本人在自己的终端窗口里运行（要输入隐藏的审批密码）。agent 不能代跑。');
+
+const local = existsSync(KEY_FILE) ? JSON.parse(readFileSync(KEY_FILE, 'utf8')) : null;
+const repoPub = L.readApproverPub(P);
+
+if (cmd === 'whoami') {
+  say('你电脑上的审批指纹：' + (local ? local.fingerprint : '（还没设置，先跑 setup）'));
+  say('仓库里登记的指纹：  ' + (repoPub.ok ? repoPub.fingerprint : '（未登记）'));
+  if (local && repoPub.ok && local.fingerprint !== repoPub.fingerprint) die('两者不一致：仓库里登记的审批人不是你。不要签任何东西，先查是谁换的。');
+  process.exit(0);
+}
+
+if (cmd === 'setup') {
+  let store = local;
+  if (!store) {
+    say('第一次设置审批密码。这个密码只有你知道，不要告诉任何 AI，也不要写进任何文件。');
+    const a = await ask('设置审批密码（至少 8 位，输入时不显示）：', true);
+    const b = await ask('再输一遍：', true);
+    if (a !== b) die('两次不一致');
+    let made; try { made = L.makeApprover(a); } catch (e) { die(e.message); }
+    mkdirSync(KEY_HOME, { recursive: true });
+    writeFileSync(KEY_FILE, JSON.stringify(made.store, null, 2), { mode: 0o600 });
+    store = made.store;
+  }
+  if (repoPub.ok && repoPub.fingerprint !== store.fingerprint) {
+    say('⚠ 仓库里已经登记了另一个审批人（指纹 ' + repoPub.fingerprint + '），不是你的。');
+    if ((await ask('确认要换成你自己，请输入「换成我」：')) !== '换成我') die('已取消');
+  }
+  mkdirSync(dirname(P.approverPub), { recursive: true });
+  writeFileSync(P.approverPub, JSON.stringify({ schema: 'awl-approver-pub/v1', fingerprint: store.fingerprint, public_key_pem: store.public_key_pem, created_at: new Date().toISOString() }, null, 2) + '\n');
+  say('\n✓ 审批人已登记。你的指纹：' + store.fingerprint);
+  say('  记下这串指纹。以后机器报告里出现的审批指纹必须和它一样，不一样就是有人冒充。');
+  process.exit(0);
+}
+
+// config / spec
+if (!local) die('你还没设置审批密码，先跑：node approve.mjs setup --repo ' + repo);
+if (!repoPub.ok) die('仓库里没有登记审批人，先跑：node approve.mjs setup --repo ' + repo);
+if (repoPub.fingerprint !== local.fingerprint) die('仓库里登记的审批人（' + repoPub.fingerprint + '）不是你（' + local.fingerprint + '）。有人换了审批人，不要签。');
+const target = cmd === 'config' ? P.config : P.spec;
+if (!existsSync(target)) die('找不到 ' + L.relP(P, target));
+const targetSha = L.shaFile(target);
+say('\n要同意的文件：' + L.relP(P, target) + '（内容指纹 ' + targetSha.slice(0, 12) + '）');
+if (cmd === 'config') {
+  const c = JSON.parse(readFileSync(target, 'utf8'));
+  say('要点（完整内容请在编辑器里看过再签）：');
+  say('  业务代码目录：' + JSON.stringify(c.business_dirs));
+  say('  每批必须跑过的检查：' + JSON.stringify(c.gates?.required_commands));
+  say('  需要你开工前确认：' + (c.acceptance?.user_confirm ? '是' : '否（技术结果全由机器自证）'));
+  say('  同时最多几批并行：' + (c.parallel?.max_batches ?? 2));
+  say('  机器生成、不许手改的文件：' + JSON.stringify((c.generated || []).map(g => g.path)));
+}
+if ((await ask('\n确认你已看过并同意，请输入「同意」：')) !== '同意') die('未同意，什么都没记录');
+const pw = await ask('输入审批密码：', true);
+let priv; try { priv = L.unlockApprover(local, pw); } catch { die('密码不对'); }
+const rec = L.signApproval(priv, local.fingerprint, cmd, L.relP(P, target), targetSha);
+const f = L.approvalFile(P, cmd, targetSha);
+mkdirSync(dirname(f), { recursive: true });
+writeFileSync(f, JSON.stringify(rec, null, 2) + '\n');
+say('\n✓ 已记录你的同意：' + L.relP(P, f));
+say('  指纹 ' + local.fingerprint + '，时间 ' + rec.approved_at);
+say('  这份文件以后改一个字，这条同意就失效，需要重新看、重新签。');
diff --git a/.agents/skills/agent-workforce-loop/scripts/check-card-scopes.mjs b/.agents/skills/agent-workforce-loop/scripts/check-card-scopes.mjs
new file mode 100644
index 0000000..d14dd70
--- /dev/null
+++ b/.agents/skills/agent-workforce-loop/scripts/check-card-scopes.mjs
@@ -0,0 +1,76 @@
+#!/usr/bin/env node
+/**
+ * 卡面 scope 自检（INC-008 的守卫，固化自 `.workforce/tmp/arch_v5_selfcheck.js` 的三口径）：
+ *   node scripts/check-card-scopes.mjs [--repo <repo>] [--dir <workforce 目录>]
+ *
+ * ① 死路径 CARD_SCOPE_DEAD_PATH：write_scopes（文件项）/ exact_file_paths 指向盘上不存在的路径
+ *    ⇒ accept 时必然炸 OUT_OF_WRITE_SCOPE。
+ * ② 未声明跨卡依赖 CARD_SCOPE_UNDECLARED_DEP：判据引用的证据路径落在别卡更具体的 scope 内，
+ *    但本卡 blocked_by 未声明该卡 ⇒ 顺序依赖未登记。
+ * ③ 幽灵路径 CARD_SCOPE_GHOST_PATH：判据引用的路径既不属于任何卡、盘上也不存在
+ *    ⇒ 本卡要写它却不在 scope 内。
+ *
+ * 无 .workforce/cards 时 PASS + skipped（安装副本场景）。
+ */
+import { readFileSync, existsSync, readdirSync, statSync } from 'node:fs';
+import { join, resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import * as L from './lib.mjs';
+
+const SKILL = resolve(join(dirname(fileURLToPath(import.meta.url)), '..'));
+const { flags } = L.parseArgs(process.argv.slice(2));
+const repoDefault = resolve(SKILL, '..', '..', '..');
+const P = L.paths(typeof flags.repo === 'string' ? resolve(flags.repo) : repoDefault, flags);
+// 全局共享目录白名单：命中者不参与「跨卡归属」判定（谁都不能独占整棵共享树）。
+// llmrust 适配：在原口径（evidence/ .workforce/ crates/ tools/ scripts/）之上补 Rust 仓常见目录
+// src/ tests/ benches/ examples/；只做并集，判定规则本身不变。
+const GLOBAL = new Set(['evidence/', '.workforce/', 'crates/', 'tools/', 'scripts/',
+  'src/', 'tests/', 'benches/', 'examples/']);
+
+const reasons = [];
+if (!existsSync(P.cards)) {
+  console.log(JSON.stringify({ verdict: 'PASS', skipped: true, reason: 'NO_WORKFORCE_CARDS ' + P.cards, cards: 0, reasons: [] }, null, 2));
+  process.exit(0);
+}
+const cards = new Map();
+for (const f of readdirSync(P.cards).filter(x => x.endsWith('.json')).sort()) {
+  const c = L.readJSON(join(P.cards, f));
+  if (!c.__error) cards.set(c.card_id || f.replace(/\.json$/, ''), c);
+}
+const exists = (p) => { try { statSync(p); return true; } catch { return false; } };
+const inScopes = (f, scopes) => (scopes || []).some(s => f === s || f.startsWith(s.endsWith('/') ? s : s + '/'));
+const ownerOf = (p, self) => {
+  let best = null, bestLen = 0;
+  for (const [id, c] of cards) {
+    if (id === self) continue;
+    for (const s of c.write_scopes || []) {
+      if (GLOBAL.has(s)) continue;
+      if (inScopes(p, [s]) && s.length > bestLen) { best = id; bestLen = s.length; }
+    }
+  }
+  return best;
+};
+const DEP_RE = /(?:\.workforce\/)?evidence\/[A-Za-z0-9_.\-/]+/g;
+let deadN = 0, undN = 0, ghostN = 0;
+for (const [id, c] of cards) {
+  for (const s of c.write_scopes || []) {
+    if (!s.endsWith('/') && !exists(resolve(P.repo, s))) { deadN++; reasons.push('CARD_SCOPE_DEAD_PATH ' + id + ' -> ' + s); }
+  }
+  for (const f of c.exact_file_paths || []) {
+    if (!exists(resolve(P.repo, f))) { deadN++; reasons.push('CARD_SCOPE_DEAD_PATH ' + id + ' -> ' + f); }
+  }
+  const text = (c.acceptance_criteria || []).join('\n');
+  const cited = new Set((text.match(DEP_RE) || []).map(x => x.replace(/[.,;:)\]`]+$/, '')));
+  for (const p of cited) {
+    if (p.startsWith('.workforce/evidence/')) continue; // 批次级回执由 loop 管
+    if (inScopes(p, c.write_scopes)) continue;         // 自有产物
+    const owner = ownerOf(p, id);
+    if (owner) {
+      if (!(c.blocked_by || []).includes(owner)) { undN++; reasons.push('CARD_SCOPE_UNDECLARED_DEP ' + id + ' 引用 ' + p + '（owner=' + owner + '，blocked_by 未声明）'); }
+    } else if (!exists(resolve(P.repo, p))) {
+      ghostN++; reasons.push('CARD_SCOPE_GHOST_PATH ' + id + ' 引用 ' + p + '（无 owner 且盘上不存在）');
+    }
+  }
+}
+console.log(JSON.stringify({ verdict: reasons.length ? 'FAIL' : 'PASS', repo: P.repo, cards: cards.size, dead: deadN, undeclared: undN, ghost: ghostN, reasons }, null, 2));
+process.exit(reasons.length ? 1 : 0);
diff --git a/.agents/skills/agent-workforce-loop/scripts/check-criteria.mjs b/.agents/skills/agent-workforce-loop/scripts/check-criteria.mjs
new file mode 100644
index 0000000..b7c7f54
--- /dev/null
+++ b/.agents/skills/agent-workforce-loop/scripts/check-criteria.mjs
@@ -0,0 +1,89 @@
+#!/usr/bin/env node
+/**
+ * 判据可判性校验器（INC-006 的新守卫）。由 validate-skill.mjs 调用，也可单独跑：
+ *   node scripts/check-criteria.mjs [--repo <repo>] [--dir <workforce 目录>]
+ *
+ * 扫 <workforce>/cards/*.json 的 acceptance_criteria，三条判据（命中即红）：
+ *   1. CRITERIA_SAMPLING_AMBIGUOUS：出现 P95/P99/min-of-N 等择优样式，却没有取样口径
+ *      （必须写明 N≥k / 跑 N 次 / ≥k 轮）也没有「中位数 / median」⇒ 可被「取最好一次」洗绿。
+ *   2. CRITERIA_ABSOLUTE_COUNT_UNVERIFIABLE：出现「恰好 N 个 / 全部 success / 必须 N 个 job 全 success」
+ *      等绝对数量断言，却没有「设计性/结构性跳过」说明 ⇒ 与设计性 skipped 冲突、结构上不可判。
+ *   3. CRITERIA_NO_BASELINE_PIN：出现「不劣于基线」却没有基线文件路径或 sha ⇒ 基线不可复核。
+ *
+ * 无 .workforce/cards 时 PASS + skipped（安装副本/纯 skill 包场景）；卡片存在但判据全合规 ⇒ PASS。
+ */
+import { readFileSync, existsSync, readdirSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { dirname } from 'node:path';
+import * as L from './lib.mjs';
+
+const SKILL = resolve(join(dirname(fileURLToPath(import.meta.url)), '..'));
+const { flags } = L.parseArgs(process.argv.slice(2));
+const repoDefault = resolve(SKILL, '..', '..', '..');
+const P = L.paths(typeof flags.repo === 'string' ? resolve(flags.repo) : repoDefault, flags);
+
+const SAMPLING = /P95|P99|min-of-(?:N|n|\d+)/i;
+const SAMPLE_SPEC = /(?:N|n)\s*(?:≥|>=|=)\s*\d+|(?:≥|>=)\s*\d+\s*(?:\/\s*N|轮|次)|跑\s*\d+\s*次|取\s*\d+\s*次|min-of-(?:3|5|10)\b/i;
+const MEDIAN = /中位数|median/i;
+const ABSOLUTE = /恰好\s*\d+\s*个|全部\s*`?success|全\s*success|必须\s*\d+\s*个\s*(?:check|job)[^。；\n]{0,20}(?:success|pass)|100%\s*(?:全绿|pass|success)/i;
+const SKIP_EXPL = /结构性跳过|设计性跳过|按设计跳过|docs-only|skipping|跳过项/i;
+const BASELINE = /不劣于基线|不低于基线|不得劣于基线/;
+const BASELINE_PIN = /(?:\.workforce|evidence)\/[\w./-]+|sha256\s*[=:]\s*[0-9a-f]{8,}|[0-9a-f]{40,64}/i;
+// INC-013：判据点名「改调用方/入口/调用点/由 X 持有/返回 RAII/在 X 里加」时，write_scopes 必须覆盖判据里点名的 .rs。
+const CALLSITE = /改调用方|调用方|调用点|入口|由[^，。；\n]{0,24}持有|返回\s*RAII|RAII/i;
+// .rs 落点前缀：原先硬编码 crates/tools/scripts，只对 beeli 的 crates 布局生效。
+// 适配：改为「静态基线 ∪ config.business_dirs ∪ Rust 仓常见源码目录」，静态基线原样保留（只做并集，不删任何前缀），
+// 因此既有判据口径不变，只是新增识别 llmrust 的 src/ tests/ benches/ examples/。
+const RS_STATIC = ['crates', 'tools', 'scripts', '.workforce'];
+const RS_RUST_DIRS = ['src', 'tests', 'benches', 'examples'];
+const RS_PREFIX = [...new Set([...RS_STATIC, ...RS_RUST_DIRS,
+  ...((L.cfg(P).business_dirs || []).map(d => String(d).replace(/\/+$/, '')).filter(Boolean))])];
+const RS_PATH = new RegExp('\\b(?:' + RS_PREFIX.map(x => x.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')/[A-Za-z0-9_./-]+\\.rs\\b', 'g');
+// INC-014：相对比值类判据（×k / 不劣于 / ≤基线×k）必须明示**聚合口径**
+// （min-of-5 / median-of-5 / all-rounds / single-run），否则 min 与 median 两种聚合结论可相反、判据不可唯一机判。
+const REL_RATIO = /(?:≤|<=|<)\s*\d+(?:\.\d+)?\s*[×xX倍]|不劣于|优于基线|相对基线/;
+const AGG_TOKEN = /min-of-(?:\d+|N)|median-of-(?:\d+|N)|median\b|max-of-(?:\d+|N)|all-rounds|single-run|均值口径|聚合口径|中位数/i;
+
+const reasons = [];
+let cards = 0; let criteria = 0;
+if (!existsSync(P.cards)) {
+  console.log(JSON.stringify({ verdict: 'PASS', skipped: true, reason: 'NO_WORKFORCE_CARDS ' + P.cards, cards: 0, criteria: 0, reasons: [] }, null, 2));
+  process.exit(0);
+}
+for (const f of readdirSync(P.cards).filter(x => x.endsWith('.json')).sort()) {
+  let c;
+  try { c = L.readJSON(join(P.cards, f)); } catch { reasons.push('CARD_INVALID_JSON ' + f); continue; }
+  if (c.__error) { reasons.push('CARD_INVALID_JSON ' + f); continue; }
+  cards++;
+  const list = Array.isArray(c.acceptance_criteria) ? c.acceptance_criteria : [];
+  const cardId = c.card_id || f.replace(/\.json$/, '');
+  // 抽样口径是「卡级」声明：允许把 min-of-N + N≥k 写在本卡另一条判据里（跨条互指），
+  // 只要整卡有取样口径/中位数即可；否则整卡只能靠「取最好一次」洗绿 ⇒ 红一次。
+  const allText = list.map(x => String(x || '')).join('\n');
+  if (SAMPLING.test(allText) && !(SAMPLE_SPEC.test(allText) || MEDIAN.test(allText))) {
+    const idx = list.findIndex(x => SAMPLING.test(String(x || '')));
+    reasons.push('CRITERIA_SAMPLING_AMBIGUOUS ' + cardId + ' criteria[' + Math.max(0, idx) + ']');
+  }
+  // INC-013：卡面 scope 漏了判据隐含的必需落点（调用方/入口/RAII 持有方）⇒ CRITERIA_SCOPE_GAP
+  if (CALLSITE.test(allText)) {
+    const named = [...new Set(allText.match(RS_PATH) || [])];
+    const inScope = (f) => (c.write_scopes || []).some(x => f === x || f.startsWith(x.endsWith('/') ? x : x + '/'));
+    const missing = named.filter(f => !inScope(f));
+    if (missing.length) reasons.push('CRITERIA_SCOPE_GAP ' + cardId + ' 判据点名调用点/入口但 write_scopes 未覆盖：' + missing.join(','));
+  }
+  // INC-014：相对比值类判据必须明示聚合口径（卡级 aggregation 字段或判据里写 min-of-5/median-of-5/…）
+  if (REL_RATIO.test(allText)) {
+    const declared = (typeof c.aggregation === 'string' && AGG_TOKEN.test(c.aggregation)) || AGG_TOKEN.test(allText);
+    if (!declared) reasons.push('CRITERIA_AGGREGATION_AMBIGUOUS ' + cardId + ' 相对比值类判据未明示聚合口径（min-of-5 / median-of-5 / all-rounds / single-run）');
+  }
+  list.forEach((t0, i) => {
+    const t = String(t0 || '');
+    criteria++;
+    const where = cardId + ' criteria[' + i + ']';
+    if (ABSOLUTE.test(t) && !SKIP_EXPL.test(t)) reasons.push('CRITERIA_ABSOLUTE_COUNT_UNVERIFIABLE ' + where);
+    if (BASELINE.test(t) && !BASELINE_PIN.test(t)) reasons.push('CRITERIA_NO_BASELINE_PIN ' + where);
+  });
+}
+console.log(JSON.stringify({ verdict: reasons.length ? 'FAIL' : 'PASS', repo: P.repo, cards, criteria, reasons }, null, 2));
+process.exit(reasons.length ? 1 : 0);
diff --git a/.agents/skills/agent-workforce-loop/scripts/check-incidents.mjs b/.agents/skills/agent-workforce-loop/scripts/check-incidents.mjs
new file mode 100644
index 0000000..0e49a44
--- /dev/null
+++ b/.agents/skills/agent-workforce-loop/scripts/check-incidents.mjs
@@ -0,0 +1,90 @@
+#!/usr/bin/env node
+/**
+ * 失误台账校验器（有牙）。由 validate-skill.mjs 调用，也可单独跑。
+ *
+ * 判据（任一不满足即 FAIL，exit 1）：
+ *  1. schema / incidents 数组 / evidence 非空 / id 形如 INC-001 且唯一
+ *  2. kind、status 必须在白名单
+ *  3. 每条 incident 至少一个 guard（不许只记录不设防 ⇒ INCIDENT_WITHOUT_ENFORCEMENT）
+ *  4. guard[].code 必须在 scripts/*.mjs 里真实存在（与 gen-docs 同一套扫描口径）
+ *  5. guard[].in 必须是 scripts/ 下真实文件名；guard[].selftest 非空时必须在 selftest.mjs 里找到同名用例
+ *  6. status=accepted_risk 时 accepted_risk.rationale+review_by 必填，review_by 过期即 FAIL
+ *  7. references/generated/incidents.md 必须与 incidents.json 机器生成结果逐字节一致（INCIDENTS_DOC_DRIFT）
+ */
+import { readFileSync, existsSync, readdirSync } from 'node:fs';
+import { join, dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { buildIncidentsDoc } from './gen-incidents.mjs';
+
+const SKILL = resolve(join(dirname(fileURLToPath(import.meta.url)), '..'));
+const KINDS = ['PREMATURE_MERGE', 'IDENTITY_FORGERY', 'CIRCULAR_RECEIPT', 'PATH_PARSE_BUG', 'CRITERIA_UNCHECKABLE',
+  'METRIC_GAMING', 'SPEC_CHANGED_IN_FLIGHT', 'DEAD_SCOPE_PATH', 'INTENTIONAL_BYPASS', 'GATE_UNUSABLE_TIMING', 'GATE_BYPASS_BY_SEQUENCE', 'GATE_BOOTSTRAP', 'SCOPE_MISSING_REQUIRED_CALLSITE', 'CRITERIA_AGGREGATION_AMBIGUOUS'];
+const STATUSES = ['enforced', 'accepted_risk'];
+const reasons = [];
+
+const incPath = join(SKILL, 'incidents.json');
+if (!existsSync(incPath)) {
+  console.log(JSON.stringify({ verdict: 'FAIL', reasons: ['INCIDENTS_JSON_MISSING'] }, null, 2));
+  process.exit(1);
+}
+let j;
+try { j = JSON.parse(readFileSync(incPath, 'utf8').replace(/^\uFEFF/, '')); }
+catch (e) { console.log(JSON.stringify({ verdict: 'FAIL', reasons: ['INCIDENTS_JSON_INVALID ' + String(e.message || e).split('\n')[0]] }, null, 2)); process.exit(1); }
+if (j.schema !== 'agent-workforce-incidents/v1') reasons.push('INCIDENT_SCHEMA_INVALID ' + j.schema);
+const list = Array.isArray(j.incidents) ? j.incidents : null;
+if (!list) reasons.push('INCIDENT_SCHEMA_INVALID incidents[] 缺失');
+const incidents = list || [];
+
+// 代码扫描口径：与 gen-docs 一致（排除 selftest / gen-docs / machine）
+const scripts = readdirSync(join(SKILL, 'scripts')).filter(f => f.endsWith('.mjs') && !['selftest.mjs', 'gen-docs.mjs', 'machine.mjs'].includes(f)).sort();
+const codeSet = new Set();
+for (const f of scripts) {
+  const src = readFileSync(join(SKILL, 'scripts', f), 'utf8');
+  for (const m of src.matchAll(/['`](?:[A-Z]+_)?([A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+)\b/g)) codeSet.add(m[0].slice(1));
+}
+const scriptNames = new Set(readdirSync(join(SKILL, 'scripts')).filter(f => f.endsWith('.mjs')));
+const selftestSrc = readFileSync(join(SKILL, 'scripts', 'selftest.mjs'), 'utf8');
+const now = new Date();
+const today = now.toISOString().slice(0, 10);
+const seen = new Set();
+const rows = [];
+let guardCount = 0;
+
+incidents.forEach((inc, idx) => {
+  const id = inc && inc.id;
+  const tag = id || ('#' + idx);
+  if (!id || !/^INC-\d{3}$/.test(String(id))) reasons.push('INCIDENT_ID_INVALID ' + tag);
+  else if (seen.has(id)) reasons.push('INCIDENT_ID_DUPLICATE ' + id);
+  else seen.add(id);
+  if (!KINDS.includes(inc.kind)) reasons.push('INCIDENT_KIND_UNKNOWN ' + tag + ' ' + inc.kind);
+  if (!STATUSES.includes(inc.status)) reasons.push('INCIDENT_STATUS_INVALID ' + tag + ' ' + inc.status);
+  if (!Array.isArray(inc.evidence) || !inc.evidence.length) reasons.push('INCIDENT_EVIDENCE_EMPTY ' + tag);
+  const guards = Array.isArray(inc.guard) ? inc.guard : [];
+  if (!guards.length) reasons.push('INCIDENT_WITHOUT_ENFORCEMENT ' + tag);
+  for (const g of guards) {
+    guardCount++;
+    const code = String((g && g.code) || '');
+    if (!codeSet.has(code)) reasons.push('INCIDENT_GUARD_CODE_UNKNOWN ' + tag + ' ' + code);
+    if (!scriptNames.has(String((g && g.in) || ''))) reasons.push('INCIDENT_GUARD_LOCATION_INVALID ' + tag + ' ' + (g && g.in));
+    const st = String((g && g.selftest) || '');
+    if (st && !selftestSrc.includes(st)) reasons.push('INCIDENT_SELFTEST_MISSING ' + tag + ' ' + st);
+  }
+  if (inc.status === 'accepted_risk') {
+    const ar = inc.accepted_risk || {};
+    if (!ar.rationale || !/^\d{4}-\d{2}-\d{2}$/.test(String(ar.review_by || ''))) reasons.push('INCIDENT_RISK_REVIEW_MISSING ' + tag);
+    else if (String(ar.review_by) < today) reasons.push('INCIDENT_RISK_REVIEW_EXPIRED ' + tag + ' review_by=' + ar.review_by + ' today=' + today);
+  }
+  rows.push({ id: id || tag, kind: inc.kind, status: inc.status, guards: guards.map(g => (g && g.code) || '?'), selftests: guards.map(g => (g && g.selftest) || '').filter(Boolean) });
+});
+
+// 生成物与数据一致（逐字节）
+const built = buildIncidentsDoc(SKILL);
+if (built.problems.length) reasons.push(...built.problems);
+else {
+  const target = join(SKILL, built.path);
+  if (!existsSync(target)) reasons.push('INCIDENTS_DOC_DRIFT ' + built.path + '（缺生成物；重跑 node scripts/gen-incidents.mjs）');
+  else if (readFileSync(target, 'utf8').replace(/\r\n/g, '\n') !== built.content) reasons.push('INCIDENTS_DOC_DRIFT ' + built.path + '（手改或未重生成；重跑 node scripts/gen-incidents.mjs）');
+}
+
+console.log(JSON.stringify({ verdict: reasons.length ? 'FAIL' : 'PASS', incidents: incidents.length, guards: guardCount, schemas: { kinds: KINDS.length, statuses: STATUSES.length }, reasons, rows }, null, 2));
+process.exit(reasons.length ? 1 : 0);
diff --git a/.agents/skills/agent-workforce-loop/scripts/check-roles.mjs b/.agents/skills/agent-workforce-loop/scripts/check-roles.mjs
new file mode 100644
index 0000000..3314d7b
--- /dev/null
+++ b/.agents/skills/agent-workforce-loop/scripts/check-roles.mjs
@@ -0,0 +1,11 @@
+#!/usr/bin/env node
+/** 只读：当前批次的工种回执是否齐全、独立、sha256 对得上实物、业务改动是否全部被认领。与 loop.mjs evidence 同一判据。 */
+import { resolve } from 'node:path';
+import * as L from './lib.mjs';
+const { flags } = L.parseArgs(process.argv.slice(2));
+const P = L.paths(resolve(typeof flags.repo === 'string' ? flags.repo : process.cwd()), flags);
+const s = L.readState(P);
+const b = L.currentBatch(s, typeof flags.batch === 'string' ? flags.batch : null);
+if (!b) L.out({ verdict: 'FAIL', reason: 'NO_CURRENT_BATCH（先 init + dispatch）' }, 1);
+const r = L.checkEvidence(P, s, b);
+L.out({ verdict: r.reasons.length ? 'FAIL' : 'PASS', batch: b.id, required: L.requiredEvidence(P, b).map(x => x.file), rows: r.rows, notes: r.notes || [], reasons: r.reasons }, r.reasons.length ? 1 : 0);
diff --git a/.agents/skills/agent-workforce-loop/scripts/gen-docs.mjs b/.agents/skills/agent-workforce-loop/scripts/gen-docs.mjs
new file mode 100644
index 0000000..e6ec954
--- /dev/null
+++ b/.agents/skills/agent-workforce-loop/scripts/gen-docs.mjs
@@ -0,0 +1,112 @@
+#!/usr/bin/env node
+/**
+ * 生成 skill 自己的机器文档，禁止手改：
+ *   references/generated/state-machine.md  ← scripts/machine.mjs 的 STATES / BATCH_STATES
+ *   references/generated/config-fields.md  ← lib.mjs 的 DEFAULT_CONFIG + machine.mjs 的 CONFIG_DOCS
+ *   references/generated/reason-codes.md   ← 扫描 scripts/*.mjs 里实际会输出的错误码
+ *   assets/config.template.json            ← DEFAULT_CONFIG
+ *   MANIFEST.json                          ← 包内每个文件的 sha256
+ * 用法：node scripts/gen-docs.mjs          重新生成
+ *       node scripts/gen-docs.mjs --check  只比对，不写；有差异 exit 1（validate-skill 调用）
+ * 另外检查手写文档和代码对得上：文档里提到的 loop 命令、错误码必须真实存在。
+ */
+import { readFileSync, writeFileSync, existsSync, mkdirSync, readdirSync, statSync } from 'node:fs';
+import { join, dirname, resolve, relative, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createHash } from 'node:crypto';
+import * as M from './machine.mjs';
+import { DEFAULT_CONFIG } from './lib.mjs';
+import { buildIncidentsDoc } from './gen-incidents.mjs';
+
+const SKILL = resolve(join(dirname(fileURLToPath(import.meta.url)), '..'));
+const CHECK = process.argv.includes('--check');
+const HEAD = '<!-- 由 scripts/gen-docs.mjs 生成，禁止手改。改 scripts/machine.mjs 或 lib.mjs 后重跑 node scripts/gen-docs.mjs -->\n\n';
+const rel = (p) => relative(SKILL, p).split(sep).join('/');
+const sha = (b) => createHash('sha256').update(b).digest('hex');
+const lf = (s) => s.replace(/\r\n/g, '\n');
+const problems = [];
+const outFiles = {};
+
+// ---------- 状态机 ----------
+const row = (k, v) => `| \`${k}\` | ${v.allowed.length ? v.allowed.map(a => '`' + a + '`').join('、') : '—'} | ${v.checks} |`;
+outFiles['references/generated/state-machine.md'] = HEAD +
+  '# 状态机（生成）\n\n## 全局状态\n\n| 状态 | 允许动作 | 脚本内部检查 |\n|---|---|---|\n' +
+  Object.entries(M.STATES).map(([k, v]) => row(k, v)).join('\n') +
+  '\n\n## 批次状态\n\n批次动作用 `--batch <id>` 指定；只有一个批次能做该动作时可省略。\n\n| 批次状态 | 允许动作 | 脚本内部检查 |\n|---|---|---|\n' +
+  Object.entries(M.BATCH_STATES).map(([k, v]) => row(k, v)).join('\n') +
+  '\n\n只读命令（任何状态可跑）：' + M.READONLY.map(c => '`' + c + '`').join('、') + '。只有架构师（--as architect-*）能跑：' + M.ARCHITECT_ONLY.map(c => '`' + c + '`').join('、') + '。\n';
+
+// ---------- 配置字段 ----------
+const flat = (o, pre = '') => Object.entries(o).flatMap(([k, v]) =>
+  v && typeof v === 'object' && !Array.isArray(v) ? flat(v, pre + k + '.') : [[pre + k, v]]);
+const fields = flat(DEFAULT_CONFIG);
+for (const [k] of fields) if (!M.CONFIG_DOCS[k]) problems.push('CONFIG_FIELD_UNDOCUMENTED ' + k + '（在 machine.mjs 的 CONFIG_DOCS 补说明）');
+for (const k of Object.keys(M.CONFIG_DOCS)) if (!fields.some(([f]) => f === k)) problems.push('CONFIG_DOC_FOR_UNKNOWN_FIELD ' + k);
+outFiles['references/generated/config-fields.md'] = HEAD +
+  '# config.json 字段（生成）\n\n| 字段 | 默认 | 作用 |\n|---|---|---|\n' +
+  fields.map(([k, v]) => `| \`${k}\` | \`${JSON.stringify(v)}\` | ${M.CONFIG_DOCS[k] || ''} |`).join('\n') + '\n';
+
+// ---------- 错误码 ----------
+const scripts = readdirSync(join(SKILL, 'scripts')).filter(f => f.endsWith('.mjs') && !['selftest.mjs', 'gen-docs.mjs', 'machine.mjs'].includes(f)).sort();
+const codes = new Map();
+for (const f of scripts) {
+  const src = readFileSync(join(SKILL, 'scripts', f), 'utf8');
+  for (const m of src.matchAll(/['`](?:[A-Z]+_)?([A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+)\b/g)) {
+    const c = m[0].slice(1);
+    if (!codes.has(c)) codes.set(c, new Set());
+    codes.get(c).add(f);
+  }
+}
+const codeList = [...codes.keys()].sort();
+outFiles['references/generated/reason-codes.md'] = HEAD +
+  '# 错误码（生成：扫描脚本里实际会输出的码）\n\n脚本拒绝时 `reason` / `reasons` 里出现的码。含义看码名和紧跟的中文说明；判定逻辑以脚本为准。\n\n| 错误码 | 出现在 |\n|---|---|\n' +
+  codeList.map(c => `| \`${c}\` | ${[...codes.get(c)].join('、')} |`).join('\n') + '\n';
+
+// ---------- 失误台账（机器生成；真源 incidents.json） ----------
+const incDoc = buildIncidentsDoc(SKILL);
+for (const p of incDoc.problems) problems.push(p);
+if (!incDoc.problems.length) outFiles[incDoc.path] = incDoc.content;
+
+// ---------- 配置模板 ----------
+outFiles['assets/config.template.json'] = JSON.stringify({ _note: '由 scripts/gen-docs.mjs 从默认配置生成，禁止手改。项目按需改这份副本后交用户本地审核', ...DEFAULT_CONFIG }, null, 2) + '\n';
+
+// ---------- 手写文档与代码对账 ----------
+const known = new Set([...Object.values(M.STATES).flatMap(v => v.allowed), ...M.READONLY, 'self-test']);
+const prose = ['SKILL.md', ...readdirSync(join(SKILL, 'references')).filter(f => f.endsWith('.md')).map(f => 'references/' + f)];
+const skipCodes = new Set(['SKILL_DIR', 'WORKFORCE_DIR', 'WORKFORCE_HEAD', 'MANIFEST_DRIFT', 'GENERATED_DOC_HAND_EDITED']);
+for (const f of prose) {
+  const t = readFileSync(join(SKILL, f), 'utf8');
+  for (const m of t.matchAll(/loop\.mjs[`"]?\s+([a-z][a-z-]+)/g)) if (!known.has(m[1])) problems.push('DOC_UNKNOWN_COMMAND ' + f + ' loop.mjs ' + m[1]);
+  for (const m of t.matchAll(/\b([A-Z][A-Z0-9]*(?:_[A-Z0-9]+){1,})\b/g)) {
+    const c = m[1];
+    if (skipCodes.has(c) || /^(SPEC|STATE)$/.test(c)) continue;
+    if (Object.keys(M.STATES).includes(c)) continue;
+    if (!codes.has(c) && !codeList.some(k => k.startsWith(c + '_') || k.endsWith('_' + c))) problems.push('DOC_UNKNOWN_CODE ' + f + ' ' + c);
+  }
+}
+
+// ---------- 写出 / 比对 ----------
+for (const [f, content] of Object.entries(outFiles)) {
+  const p = join(SKILL, f);
+  if (CHECK) {
+    if (!existsSync(p)) problems.push('GENERATED_DOC_MISSING ' + f);
+    else if (lf(readFileSync(p, 'utf8')) !== content) problems.push('GENERATED_DOC_HAND_EDITED ' + f + '（禁止手改；改源头后重跑 node scripts/gen-docs.mjs）');
+  } else { mkdirSync(dirname(p), { recursive: true }); writeFileSync(p, content); }
+}
+
+// ---------- MANIFEST ----------
+const walk = (d) => readdirSync(d).flatMap(x => { const p = join(d, x); return statSync(p).isDirectory() ? walk(p) : [p]; });
+const files = walk(SKILL).map(rel).filter(f => f !== 'MANIFEST.json' && !f.startsWith('.')).sort();
+const manifest = { _note: '由 scripts/gen-docs.mjs 生成，禁止手改。每个文件的 sha256（换行统一为 LF 后计算）', files: Object.fromEntries(files.map(f => [f, sha(lf(readFileSync(join(SKILL, f), 'utf8')))])) };
